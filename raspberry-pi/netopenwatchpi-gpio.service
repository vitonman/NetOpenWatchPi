[Unit]
Description=NetOpenWatchPi GPIO navigation bridge
After=multi-user.target

[Service]
Type=simple
WorkingDirectory=/home/pi/NetOpenWatchPi/raspberry-pi
ExecStart=/usr/bin/python3 /home/pi/NetOpenWatchPi/raspberry-pi/gpio_nav_bridge_uinput.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
